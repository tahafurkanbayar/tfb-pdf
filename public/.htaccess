# tfb-pdf — public/.htaccess (front controller)

Options -Indexes -MultiViews
DirectoryIndex index.php

# PHP hatalarının yanıta yazılmasını kapatır. Uygulama bunu çalışırken de yapar, ancak PHP'nin
# istek başındaki uyarıları (ör. post_max_size aşımı) uygulama başlamadan basılır ve JSON
# yanıtını bozar. Yalnızca mod_php'de geçerlidir (PHP-FPM/CGI'de php_flag 500 hatası verir;
# orada aynı ayarı public/.user.ini yapar). Sunucuda log_errors açıksa uyarılar sunucu log'una yazılır.
<IfModule mod_php.c>
    php_flag display_errors Off
</IfModule>

# PDF.js ES module dosyaları için doğru MIME tipi (bazı sunucularda tanımlı değil)
<IfModule mod_mime.c>
    AddType application/javascript .js .mjs
    AddType application/wasm .wasm
    AddType font/woff2 .woff2
    AddType application/manifest+json .webmanifest
</IfModule>

# Gizli dosyalar ve uygulama kökünü gösteren app-root.php (public/ içeriği public_html'e kopyalandıysa)
<FilesMatch "^(\.|app-root\.php$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On

    RewriteRule ^\.well-known/ - [L]

    # HTTPS yönlendirmesi: sertifika kurulduktan sonra açın.
    # RewriteCond %{HTTPS} !=on
    # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Var olan statik dosyalar doğrudan sunulur, geri kalan her şey index.php'ye gider
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L,QSA]
</IfModule>

# Statik dosyalar için tarayıcı önbelleği
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
    ExpiresByType image/svg+xml "access plus 30 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType font/woff2 "access plus 30 days"
</IfModule>

# Statik dosyalar için; PHP yanıtlarının güvenlik başlıklarını uygulama kendisi ekler
<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|mjs|svg|png|jpg|woff2?|wasm|txt)$">
        Header set X-Content-Type-Options "nosniff"
    </FilesMatch>
</IfModule>
