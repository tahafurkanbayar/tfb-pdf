{
    "name": "tahafurkanbayar/tfb-pdf",
    "description": "Self-hosted, open-source PDF management and editing platform (TR/EN) for cPanel shared hosting.",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "Taha Furkan Bayar"
        }
    ],
    "require": {
        "php": ">=8.2",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-mbstring": "*",
        "ext-json": "*",
        "ext-zlib": "*",
        "ext-hash": "*",
        "setasign/fpdi": "^2.6",
        "setasign/tfpdf": "^1.33",
        "phpmailer/phpmailer": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "suggest": {
        "ext-zip": "ZIP export ve bölünen dosyaların toplu indirilmesi için",
        "ext-fileinfo": "Yüklenen dosyaların MIME tipinin doğrulanması için",
        "ext-gd": "Thumbnail cache, imza görselleri ve PHP tabanlı görsel sıkıştırma için"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.2.12"
        },
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
