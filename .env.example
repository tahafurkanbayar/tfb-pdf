# tfb-pdf yapılandırması
# Bu dosyayı .env adıyla kopyalayın ve değerleri doldurun. .env asla commit edilmez.
# Copy this file to .env and fill in the values. Never commit .env.

# --- Uygulama / Application ---
APP_NAME="TFB PDF"
# production | local
APP_ENV=production
# Production'da mutlaka false. / Must be false in production.
APP_DEBUG=false
# Sonunda / olmadan. / Without trailing slash. Örn: https://pdf.example.com veya http://localhost/tfb-pdf
APP_URL=
# En az 32 karakterlik rastgele değer. Kurulum sayfası sizin için üretebilir.
# At least 32 random characters. The installer can generate one for you.
APP_KEY=
APP_TIMEZONE=Europe/Istanbul
# SSL sertifikası kurulduktan sonra true yapın.
FORCE_HTTPS=false
HSTS_ENABLED=false
# Reverse proxy / Cloudflare arkasındaysanız proxy IP'leri (virgülle ayrılmış)
TRUSTED_PROXIES=
# debug | info | warning | error
LOG_LEVEL=info

# --- Kurulum / Installer ---
# Web kurulum ve migration sayfası (/install) için gizli anahtar. Boş bırakılırsa sayfa kapalıdır.
# Kurulum bittikten sonra boşaltmanız önerilir.
INSTALL_KEY=

# --- Veritabanı / Database (MySQL 8+ veya MariaDB 10.4+) ---
DB_HOST=localhost
DB_PORT=3306
DB_SOCKET=
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# --- Depolama / Storage ---
# Boşsa proje kökündeki storage/ kullanılır. Mümkünse web root dışında mutlak yol verin.
STORAGE_PATH=
# Yeni belgelerin varsayılan saklama süresi: 1d | 7d | 30d | never
DEFAULT_EXPIRY=7d
# Cron kurulamıyorsa istekler sırasında küçük temizlik yapılır.
OPPORTUNISTIC_CLEANUP=true
TEMPORARY_TTL_HOURS=6
PREVIEW_TTL_DAYS=14

# --- Limitler / Limits ---
# Birimler: K, M, G
MAX_UPLOAD_SIZE=25M
MAX_FILES_PER_OPERATION=20
MAX_PAGES_PER_DOCUMENT=500
# Tarayıcı başına toplam depolama, 0 = sınırsız
MAX_STORAGE_PER_OWNER=500M
# IP başına saatlik sınırlar, 0 = kapalı
RATE_LIMIT_UPLOADS_PER_HOUR=60
RATE_LIMIT_OPERATIONS_PER_HOUR=120
RATE_LIMIT_SIGNATURES_PER_HOUR=30

# --- Opsiyonel sunucu araçları / Optional server tools ---
# Boş: PATH'te otomatik ara · mutlak yol: o dosyayı kullan · disabled: kapat
GHOSTSCRIPT_PATH=
LIBREOFFICE_PATH=
TESSERACT_PATH=
TESSERACT_LANGS=tur+eng
EXTERNAL_TOOL_TIMEOUT=120

# --- E-posta / Email (opsiyonel) ---
# SMTP_HOST boşsa e-posta kapalıdır; imza davet bağlantıları ekranda gösterilir.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# tls | ssl | none
SMTP_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="TFB PDF"

# --- İmza / Signature ---
SIGNATURE_INVITE_DAYS=14
